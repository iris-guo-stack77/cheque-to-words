<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cheque to Words</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChequeToWords.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container">
            <span class="app-brand">🏦 Cheque to Words</span>
            <span class="app-subtitle">BookingTimes take-home assessment</span>
        </div>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer text-muted">
        <div class="container">
            Built with ASP.NET Core MVC &middot; Iris Guo
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
